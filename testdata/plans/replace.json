        "before": {"type": "io1", "size": 100, "iops": 5000, "region": "us-east-1"},
        "after": {"type": "io2", "size": 200, "iops": 70000, "region": "us-east-1"},
        "after_unknown": {"throughput": true, "id": true}
      }
    }
  ],
  "configuration": {
    "provider_config": {
      "aws": {"name": "aws", "full_name": "registry.terraform.io/hashicorp/aws", "expressions": {"region": {"constant_value": "us-east-1"}}}
