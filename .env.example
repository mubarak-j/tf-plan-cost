# tf-plan-cost App server (`tf-plan-cost serve`). Copy to .env and fill in.
# Never commit the real values.

# From the GitHub App's settings page.
GITHUB_APP_ID=
# PEM contents, or a path to the downloaded .pem file.
GITHUB_PRIVATE_KEY=./tf-plan-cost.private-key.pem
GITHUB_WEBHOOK_SECRET=

# Optional.
PORT=8080
# TF_PLAN_COST_LISTEN_HOST=127.0.0.1
# GITHUB_API_URL=https://api.github.com
# GITHUB_SERVER_URL=https://github.com
# TF_PLAN_COST_OIDC_AUDIENCE=tf-plan-cost
# TF_PLAN_COST_CACHE_DIR=/tmp/tf-plan-cost-cache

# Prices are read with the standard AWS credential chain; the credentials
# need only pricing:GetProducts. For example:
# AWS_PROFILE=my-sso-profile
